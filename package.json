{
  "name": "bstackbank-automation",
  "version": "1.0.0",
  "description": "BStackBank Mobile Automation - WebdriverIO + Appium + Cucumber BDD",
  "scripts": {
    "test": "PLATFORM=all wdio run wdio.conf.js",
    "test:pixel": "PLATFORM=android wdio run wdio.conf.js",
    "test:signup": "PLATFORM=android wdio run wdio.conf.js --spec features/signup.feature",
    "test:view-balance": "PLATFORM=android wdio run wdio.conf.js --spec features/view-balance.feature",
    "test:delete-account": "PLATFORM=android wdio run wdio.conf.js --spec features/delete-account.feature",
    "test:smoke": "PLATFORM=android wdio run wdio.conf.js --cucumberOpts.tagExpression='@smoke'",
    "test:regression": "PLATFORM=android wdio run wdio.conf.js --cucumberOpts.tagExpression='@regression'",
    "test:xiaomi": "PLATFORM=androidOnePlus wdio run wdio.conf.js"
  },
  "devDependencies": {
    "@wdio/browserstack-service": "^9.0.0",
    "@wdio/cli": "^9.31.9",
    "@wdio/cucumber-framework": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.0.0",
    "dotenv": "^16.0.0"
  }
}
